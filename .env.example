# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Where next.config.ts's /api/* rewrite proxies to. Resolved once at `next
# build` time (not read again at `next start`), so it must be set BEFORE
# building, not just before starting. Vercel's Production environment sets
# this explicitly — do not rely on any fallback in next.config.ts for a real
# deploy. Leaving this unset locally defaults to http://localhost:5001.
BACKEND_URL=http://localhost:5001

# Google Analytics 4 measurement ID (optional — GA is skipped entirely if unset)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Ads conversion ID (optional — Ads conversion tracking skipped if unset).
# The "WebiGeeks" Google Ads account's existing "Contact" website conversion action.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-16786302575
